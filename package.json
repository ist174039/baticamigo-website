    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.31",
    "tailwindcss": "^3.4.19",
