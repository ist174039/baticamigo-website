rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The private platform is server-mediated. Firebase client SDKs must not
    // read or write operational data directly. The Admin SDK used by the
    // authenticated Next.js API is governed by IAM, not these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
