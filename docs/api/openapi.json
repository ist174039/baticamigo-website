{
  "openapi": "3.1.0",
  "info": {
    "title": "BaticAmigo Platform API",
    "version": "1.0.0",
    "description": "Contrato da API privada BaticAmigo. A autorização é aplicada no servidor por papel, relação e objeto."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase ID token"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "error": {
            "type": "string",
            "description": "Compatibilidade temporária com clientes existentes; igual a detail."
          },
          "code": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "Problem": {
        "description": "Erro RFC 9457",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/platform": {
      "get": {
        "summary": "Ler dados autorizados da plataforma",
        "responses": {
          "200": {
            "description": "Dados autorizados"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "summary": "Executar mutação autorizada da plataforma",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "201": {
            "description": "Recurso criado"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/platform/finance": {
      "get": {
        "summary": "Ler dados financeiros autorizados",
        "responses": {
          "200": {
            "description": "Dados financeiros autorizados"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "summary": "Executar operação financeira administrativa",
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "201": {
            "description": "Recurso criado"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/platform/users": {
      "get": {
        "summary": "Listar utilizadores/perfis administráveis",
        "responses": {
          "200": {
            "description": "Utilizadores autorizados"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "summary": "Criar conta/perfis ou iniciar recuperação de acesso",
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "201": {
            "description": "Conta/perfis criados"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "patch": {
        "summary": "Alterar acesso, suspender/restaurar ou eliminar perfil sem dependências",
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "delete": {
        "summary": "Remover conta preservando registos de pessoa quando aplicável",
        "responses": {
          "200": {
            "description": "Conta removida"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/platform/files": {
      "post": {
        "summary": "Carregar ficheiro privado autorizado",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "kind",
                  "studentId"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "contentMediaType": "application/octet-stream"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "assignment",
                      "material",
                      "document",
                      "justification"
                    ]
                  },
                  "studentId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ficheiro guardado"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/contact": {
      "post": {
        "summary": "Enviar contacto público à associação",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "subject",
                  "message"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 6000
                  },
                  "website": {
                    "type": "string",
                    "description": "Honeypot; deve permanecer vazio para utilizadores legítimos."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contacto aceite e persistido"
          },
          "202": {
            "description": "Pedido aceite sem persistência (proteção anti-bot)"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "summary": "Validar acesso administrativo e obter conteúdo administrativo legado autorizado",
        "responses": {
          "200": {
            "description": "Acesso válido/dados autorizados"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "410": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "summary": "Operação administrativa legada limitada (recuperação da própria conta)",
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "410": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "patch": {
        "summary": "Gestão de utilizadores movida para a Área",
        "responses": {
          "410": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "delete": {
        "summary": "Gestão de utilizadores movida para a Área",
        "responses": {
          "410": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  }
}
